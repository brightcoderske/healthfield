# Vercel storefront only. Database, SMTP and storage credentials belong in api-service/.env.
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
API_SHARED_SECRET=replace-with-a-separate-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:3001

# Browser Google Maps key, used by the checkout and admin location pickers. Restrict it
# by HTTP referrer to this site, and enable Maps JavaScript API + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Celcom Africa bulk SMS (API service only — never expose these to the browser)
#
# Get the key and partner ID from the Celcom dashboard: "GET API KEY & PARTNER ID".
# The sender ID (shortcode) must be registered and approved by Celcom before it will
# deliver; until then messages are rejected with code 1001.
#
# SMS stays completely inert until the key, the partner ID and at least one sender ID
# are all set, so it is safe to deploy this file before the account exists.
# ---------------------------------------------------------------------------
CELCOM_SMS_API_KEY=
CELCOM_SMS_PARTNER_ID=

# Celcom issues two sender IDs on one account and one API key: one cleared for
# transactional traffic (orders, payments, OTP) and one for promotional traffic
# (campaigns). The system picks the right one from the kind of message being sent —
# nobody chooses it in the admin, and marketing can never go out under the
# transactional ID. Setting the plain CELCOM_SMS_SENDER_ID instead makes one ID serve
# both, which is only a stopgap until Celcom issues the second.
CELCOM_SMS_SENDER_ID_TRANSACTIONAL=
CELCOM_SMS_SENDER_ID_PROMOTIONAL=
# CELCOM_SMS_SENDER_ID=

# Endpoints. Only set these if Celcom moves them; the documented defaults are built in.
# CELCOM_SMS_SEND_URL=https://isms.celcomafrica.com/api/services/sendsms/
# CELCOM_SMS_DLR_URL=https://isms.celcomafrica.com/api/services/getdlr/
# CELCOM_SMS_BALANCE_URL=https://isms.celcomafrica.com/api/services/getbalance/

# Kill switches. Transactional covers order and payment messages plus OTP; marketing
# covers campaigns. Both default to on once credentials exist. Set to "false" to pause
# one without unsetting the credentials.
# CELCOM_SMS_TRANSACTIONAL_ENABLED=true
# CELCOM_SMS_MARKETING_ENABLED=true

# Set to "true" to log every message instead of sending it. Use this to rehearse a
# campaign, or to run staging, without spending credits.
# CELCOM_SMS_DRY_RUN=false
