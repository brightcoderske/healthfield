NODE_ENV=production
PORT=3001
DATABASE_URL=mysql://user:password@127.0.0.1:3306/database
AUTH_SECRET=replace-with-a-long-random-secret-used-for-reset-and-upload-tokens
API_SHARED_SECRET=replace-with-a-separate-long-random-secret
API_PUBLIC_URL=https://api.healthfieldpharmacy.co.ke
APP_URL=https://healthfieldpharmacy.co.ke
CORS_ALLOWED_ORIGINS=https://healthfieldpharmacy.co.ke,https://www.healthfieldpharmacy.co.ke
STORAGE_ROOT=/home/healthfi/healthfield-storage
RUN_MIGRATIONS=true
DB_POOL_SIZE=10
SMTP_HOST=mail.healthfieldpharmacy.co.ke
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Healthfield Pharmacy
SMTP_ORDERS_USER=orders@healthfieldpharmacy.co.ke
SMTP_SECURITY_USER=security@healthfieldpharmacy.co.ke
NOTIFICATION_EMAIL=

# Safaricom Daraja. M-Pesa Express remains unavailable until every required
# value is present and the administrator enables it in Website settings.
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=5555
MPESA_CONSUMER_SECRET=666
MPESA_SHORTCODE=ccc
MPESA_PASSKEY=vvv
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_BASE_URL=https://api.healthfieldpharmacy.co.ke
MPESA_CALLBACK_SECRET=ccc

# Register these neutral public URLs in Daraja for automatic manual-till matching.
# Replace YOUR_ENDPOINT_SECRET with the MPESA_CALLBACK_SECRET value configured above.
# Confirmation URL:
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/c2b/confirmation/YOUR_ENDPOINT_SECRET
# Verification URL (Daraja's Validation URL field):
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/c2b/verification/YOUR_ENDPOINT_SECRET
# STK result notifications are sent to:
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/stk/notification/YOUR_ENDPOINT_SECRET
