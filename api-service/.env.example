NODE_ENV=production
PORT=3001
DATABASE_URL=mysql://user:password@127.0.0.1:3306/database
AUTH_SECRET=replace-with-a-long-random-secret-used-for-reset-and-upload-tokens
API_SHARED_SECRET=replace-with-a-separate-long-random-secret
API_PUBLIC_URL=https://api.healthfieldpharmacy.co.ke
APP_URL=https://healthfieldpharmacy.co.ke
CORS_ALLOWED_ORIGINS=https://healthfieldpharmacy.co.ke,https://www.healthfieldpharmacy.co.ke
STORAGE_ROOT=/home/healthfi/healthfield-storage
RUN_MIGRATIONS=true
DB_POOL_SIZE=10
SMTP_HOST=mail.healthfieldpharmacy.co.ke
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Healthfield Pharmacy
SMTP_ORDERS_USER=orders@healthfieldpharmacy.co.ke
SMTP_SECURITY_USER=security@healthfieldpharmacy.co.ke
NOTIFICATION_EMAIL=

# Safaricom Daraja. M-Pesa Express remains unavailable until every required
# value is present and the administrator enables it in Website settings.
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-with-production-consumer-key
MPESA_CONSUMER_SECRET=replace-with-production-consumer-secret
# Business shortcode/store/HO number used during Daraja Go Live.
MPESA_SHORTCODE=replace-with-production-shortcode
MPESA_PASSKEY=replace-with-production-passkey
# Use CustomerPayBillOnline for a PayBill shortcode or CustomerBuyGoodsOnline
# for a Buy Goods/Till shortcode. This must match the shortcode and passkey.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Required only for CustomerBuyGoodsOnline: the actual Till number credited as PartyB.
MPESA_PARTY_B=
MPESA_CALLBACK_BASE_URL=https://api.healthfieldpharmacy.co.ke
MPESA_CALLBACK_SECRET=replace-with-at-least-24-random-characters

# Required for the asynchronous Transaction Status API. SecurityCredential is
# the production initiator password encrypted for Safaricom, not the plaintext password.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Pull Transactions is a callback-loss safety net. Keep this false until the
# product is live and its dedicated callback has been registered once.
MPESA_PULL_ENABLED=false
# Safaricom-nominated organization phone in 2547XXXXXXXX format. It is needed
# only by the one-time `npm run register:pull` callback registration command.
MPESA_PULL_NOMINATED_NUMBER=

# Register these neutral public URLs in Daraja for automatic manual-till matching.
# Replace YOUR_ENDPOINT_SECRET with the MPESA_CALLBACK_SECRET value configured above.
# Confirmation URL:
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/c2b/confirmation/YOUR_ENDPOINT_SECRET
# Verification URL (Daraja's Validation URL field):
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/c2b/verification/YOUR_ENDPOINT_SECRET
# STK result notifications are sent to:
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/stk/notification/YOUR_ENDPOINT_SECRET
# Transaction Status supplies these URLs with each request:
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/status/result/YOUR_ENDPOINT_SECRET
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/status/timeout/YOUR_ENDPOINT_SECRET
# Pull Transactions requires this third callback to be registered once:
# https://api.healthfieldpharmacy.co.ke/v1/payments/mobile-money/recovery/notification/YOUR_ENDPOINT_SECRET
# After deploying the API and setting MPESA_PULL_NOMINATED_NUMBER, run from the
# deployed api-service directory: npm run register:pull

# Server-side Google Maps key, used only to measure driving distance when pricing a
# delivery. Enable the "Routes API" on the project (NOT the legacy Distance Matrix API,
# which Google no longer enables for new projects) and restrict the key by IP to this
# server. When unset or rejected, delivery falls back to padded straight-line distance
# and still works.
GOOGLE_MAPS_API_KEY=
